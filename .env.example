
# SiGeRU - Variables para Docker Compose
# Copiar este archivo como .env y completar los valores.
# Nunca subir el archivo .env real a GitHub.

# API Usuarios
USUARIOS_APP_KEY=
USUARIOS_JWT_SECRET=

# API Gestion
GESTION_APP_KEY=

# API Recoleccion
RECOLECCION_APP_KEY=

# Base de datos MySQL
# Deben coincidir con MYSQL_USER y MYSQL_PASSWORD
# definidos en docker-compose.yml
SIGERU_DB_USERNAME=sigeru
SIGERU_DB_PASSWORD=sigeru

# Notificaciones Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
