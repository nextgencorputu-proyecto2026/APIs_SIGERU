# SiGeRU - Variables para Docker Compose
# Copiar este archivo como .env y completar los valores.
# Nunca subir el archivo .env real a GitHub.

# API Usuarios
USUARIOS_APP_KEY=
USUARIOS_JWT_SECRET=

# API Gestion
GESTION_APP_KEY=

# API Recoleccion
RECOLECCION_APP_KEY=

# Credenciales MySQL compartidas por las tres APIs
SIGERU_DB_USERNAME=
SIGERU_DB_PASSWORD=
